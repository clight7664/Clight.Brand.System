<div class="p-4 rounded-xl border @Rule.VisualStyleClass flex flex-col justify-between space-y-3 min-h-[260px]">
    <!-- Header with Badge -->
    <div class="flex items-center justify-between">
        <span class="text-[10px] font-mono font-bold uppercase tracking-wider px-2 py-0.5 rounded shrink-0 @(Rule.IsAllowed ? "bg-emerald-500/20 text-emerald-700 dark:text-emerald-300" : "bg-rose-500/20 text-rose-700 dark:text-rose-300")">
            @Rule.BadgeText
        </span>
        <span class="text-xs font-medium text-neutral-400">Governance</span>
    </div>

    <!-- Illustration / Visual Representation -->
    <div class="w-full h-28 rounded-lg bg-white dark:bg-neutral-900 border border-neutral-200/50 dark:border-neutral-800 flex items-center justify-center overflow-hidden">
        <div class="w-12 h-12 flex items-center justify-center @GetViolationStyle()">
            <svg viewBox="0 0 512 512" class="w-12 h-12 @GetSvgColorClass()" fill="currentColor">
                <path d="M 408.825 97.745 A 220.000 220.000 0 1 0 408.825 414.255 A 209.518 209.518 0 1 1 408.825 97.745 Z" />
            </svg>
        </div>
    </div>

    <!-- Description -->
    <div>
        <h4 class="text-sm font-semibold text-neutral-900 dark:text-white truncate" title="@Rule.Title">@Rule.Title</h4>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 mt-1 line-clamp-2" title="@Rule.Description">@Rule.Description</p>
    </div>
</div>

@code {
    [Parameter] public UsageRule Rule { get; set; } = new();

    private string GetViolationStyle()
    {
        if (Rule.IsAllowed) return "";
        if (Rule.Title.Contains("Stretch") || Rule.Title.Contains("拉伸") || Rule.Title.Contains("変形") || Rule.Title.Contains("비율")) return "scale-x-150 scale-y-50";
        if (Rule.Title.Contains("Rotate") || Rule.Title.Contains("旋转") || Rule.Title.Contains("回転") || Rule.Title.Contains("회전")) return "rotate-90";
        if (Rule.Title.Contains("Shadow") || Rule.Title.Contains("阴影") || Rule.Title.Contains("影") || Rule.Title.Contains("그림자")) return "drop-shadow-[0_10px_8px_rgba(239,68,68,0.5)]";
        if (Rule.Title.Contains("Stroke") || Rule.Title.Contains("描边") || Rule.Title.Contains("線") || Rule.Title.Contains("외곽선")) return "stroke-[8] stroke-rose-500 fill-none";
        return "";
    }

    private string GetSvgColorClass()
    {
        if (!Rule.IsAllowed && (Rule.Title.Contains("Palette") || Rule.Title.Contains("色彩") || Rule.Title.Contains("カラー") || Rule.Title.Contains("색상"))) return "text-purple-500";
        return "text-[#111111] dark:text-[#FAF9F6]";
    }
}
