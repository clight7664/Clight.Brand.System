@inject IJSRuntime JSRuntime
@inject ISvgLogoRenderer SvgRenderer

<div class="p-4 rounded-xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-3">
    <div class="flex items-center justify-between">
        <div>
            <h4 class="text-sm font-semibold text-neutral-900 dark:text-white">Quick Export (快捷导出)</h4>
            <p class="text-xs text-neutral-500">Download individual raster or vector formats immediately</p>
        </div>
        <button @onclick="ExportAllZip" disabled="@isExporting" class="inline-flex items-center px-3 py-1.5 text-xs font-semibold text-white bg-neutral-900 dark:bg-white dark:text-neutral-900 rounded-lg hover:bg-neutral-800 transition-colors shadow-sm disabled:opacity-50">
            @if (isExporting)
            {
                <span>Packaging ZIP...</span>
            }
            else
            {
                <svg class="w-3.5 h-3.5 mr-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                <span>Export All (ZIP)</span>
            }
        </button>
    </div>

    <!-- Quick Size Buttons -->
    <div class="flex flex-wrap gap-2 pt-1">
        @foreach (var size in new[] { 16, 32, 48, 64, 128, 256, 512, 1024 })
        {
            <button @onclick="() => DownloadPng(size)" class="px-3 py-1 text-xs font-mono rounded-lg border border-neutral-200 dark:border-neutral-700 hover:border-neutral-400 dark:hover:border-neutral-500 bg-neutral-50 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-colors flex items-center space-x-1">
                <span>@(size)px</span>
                <svg class="w-3 h-3 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
            </button>
        }
        <button @onclick="DownloadSvg" class="px-3 py-1 text-xs font-semibold rounded-lg bg-neutral-200 dark:bg-neutral-700 text-neutral-800 dark:text-neutral-200 hover:bg-neutral-300 dark:hover:bg-neutral-600 transition-colors">
            .SVG (Black)
        </button>
        <button @onclick="DownloadSvgWhiteTransparent" class="px-3 py-1 text-xs font-semibold rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 hover:bg-neutral-800 dark:hover:bg-neutral-100 transition-colors shadow-sm">
            .SVG (White)
        </button>
        <button @onclick="DownloadSvgDarkTheme" class="px-3 py-1 text-xs font-semibold rounded-lg border border-neutral-700 bg-neutral-950 text-white hover:bg-neutral-800 transition-colors">
            .SVG (Dark BG)
        </button>
    </div>
</div>

@code {
    [Parameter] public LogoParameters Parameters { get; set; } = LogoParameters.CreateApproved();
    private bool isExporting = false;

    private async Task DownloadPng(int size)
    {
        string svg = SvgRenderer.RenderSvg(Parameters);
        await JSRuntime.InvokeVoidAsync("logoStudio.renderSvgToPngAndDownload", svg, size, size, $"clight-logo-{size}.png", null);
    }

    private async Task DownloadSvg()
    {
        string svg = SvgRenderer.RenderSvg(Parameters, new SvgRenderOptions { IncludeXmlDeclaration = true });
        await JSRuntime.InvokeVoidAsync("logoStudio.downloadTextFile", "clight-logo.svg", svg, "image/svg+xml");
    }

    private async Task DownloadSvgWhiteTransparent()
    {
        string svg = SvgRenderer.RenderSvg(Parameters, new SvgRenderOptions { FillColor = "#FFFFFF", BackgroundColor = null, IncludeXmlDeclaration = true });
        await JSRuntime.InvokeVoidAsync("logoStudio.downloadTextFile", "clight-logo-white-transparent.svg", svg, "image/svg+xml");
    }

    private async Task DownloadSvgDarkTheme()
    {
        string svg = SvgRenderer.RenderSvg(Parameters, new SvgRenderOptions { FillColor = "#FFFFFF", BackgroundColor = "#111111", IncludeXmlDeclaration = true });
        await JSRuntime.InvokeVoidAsync("logoStudio.downloadTextFile", "clight-logo-white.svg", svg, "image/svg+xml");
    }

    private async Task ExportAllZip()
    {
        isExporting = true;
        StateHasChanged();
        try
        {
            string svg = SvgRenderer.RenderSvg(Parameters);
            await JSRuntime.InvokeVoidAsync("logoStudio.exportAllAssetsAsZip", svg, "Clight.Brand.Assets.zip");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }
}
