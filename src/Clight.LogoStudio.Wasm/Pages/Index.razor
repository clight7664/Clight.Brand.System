@page "/"
@page "/dashboard"
@inject IGuidelineProvider GuidelineProvider
@inject ISvgLogoRenderer SvgRenderer

<div class="space-y-8 animate-fade-in">
    <!-- Hero Banner -->
    <div class="relative overflow-hidden rounded-3xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/60 backdrop-blur-xl p-8 md:p-12">
        <div class="max-w-3xl space-y-4">
            <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-neutral-900/5 dark:bg-white/10 text-xs font-mono text-neutral-600 dark:text-neutral-300">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                <span>AI-Native Brand System • 月 · 兰 · C</span>
            </div>
            <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-neutral-900 dark:text-white font-sans">
                Welcome to <br class="hidden sm:inline" />
                <span class="font-serif italic font-normal">Clight Logo Studio</span>
            </h1>
            <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-400 font-light max-w-2xl">
                Design. Preview. Generate. Export. A precision parametric brand identity system engineered with golden ratio curvature, fluid aesthetics, and Eastern negative space.
            </p>
        </div>

        <!-- Floating Ambient Symbol Background -->
        <div class="absolute right-4 -bottom-10 md:bottom-auto md:right-8 md:top-1/2 md:-translate-y-1/2 opacity-10 dark:opacity-25 pointer-events-none w-64 h-64 md:w-80 md:h-80 text-neutral-900 dark:text-white transition-opacity">
            @((MarkupString)SvgRenderer.RenderSvg(LogoParameters.CreateApproved(), new SvgRenderOptions { Responsive = true, FillColor = "currentColor" }))
        </div>
    </div>

    <!-- 4 Core Functional Feature Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- 1. Preview Card -->
        <a href="preview" class="group relative flex flex-col justify-between p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/60 dark:bg-neutral-900/50 hover:bg-white dark:hover:bg-neutral-900 hover:shadow-lg transition-all">
            <div class="space-y-3">
                <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-800 dark:text-white group-hover:scale-110 transition-transform">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" stroke-width="1.5" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 3a9 9 0 000 18v-18z" /></svg>
                </div>
                <div>
                    <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Preview</h3>
                    <p class="text-xs text-neutral-500 mt-1">实时预览 Logo 效果，多背景多尺寸实时缩放矩阵</p>
                </div>
            </div>
            <div class="pt-4 flex items-center text-xs font-semibold text-neutral-900 dark:text-white group-hover:translate-x-1 transition-transform">
                <span>Open Preview</span>
                <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </div>
        </a>

        <!-- 2. Generator Card -->
        <a href="generator" class="group relative flex flex-col justify-between p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/60 dark:bg-neutral-900/50 hover:bg-white dark:hover:bg-neutral-900 hover:shadow-lg transition-all">
            <div class="space-y-3">
                <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-800 dark:text-white group-hover:scale-110 transition-transform">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
                </div>
                <div>
                    <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Generator</h3>
                    <p class="text-xs text-neutral-500 mt-1">自定义生成 Logo，调整曲线、外径、内径与黄金比例</p>
                </div>
            </div>
            <div class="pt-4 flex items-center text-xs font-semibold text-neutral-900 dark:text-white group-hover:translate-x-1 transition-transform">
                <span>Open Generator</span>
                <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </div>
        </a>

        <!-- 3. Export Card -->
        <a href="export" class="group relative flex flex-col justify-between p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/60 dark:bg-neutral-900/50 hover:bg-white dark:hover:bg-neutral-900 hover:shadow-lg transition-all">
            <div class="space-y-3">
                <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-800 dark:text-white group-hover:scale-110 transition-transform">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                </div>
                <div>
                    <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Export</h3>
                    <p class="text-xs text-neutral-500 mt-1">导出各种规格资源：SVG, PNG, ICO, Favicon 及 Web 资源包</p>
                </div>
            </div>
            <div class="pt-4 flex items-center text-xs font-semibold text-neutral-900 dark:text-white group-hover:translate-x-1 transition-transform">
                <span>Open Export</span>
                <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </div>
        </a>

        <!-- 4. Guideline Card -->
        <a href="guideline" class="group relative flex flex-col justify-between p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/60 dark:bg-neutral-900/50 hover:bg-white dark:hover:bg-neutral-900 hover:shadow-lg transition-all">
            <div class="space-y-3">
                <div class="w-10 h-10 rounded-xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center text-neutral-800 dark:text-white group-hover:scale-110 transition-transform">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                </div>
                <div>
                    <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Guideline</h3>
                    <p class="text-xs text-neutral-500 mt-1">品牌规范与使用指南：几何构造线、安全留白与标准字体</p>
                </div>
            </div>
            <div class="pt-4 flex items-center text-xs font-semibold text-neutral-900 dark:text-white group-hover:translate-x-1 transition-transform">
                <span>Open Guideline</span>
                <svg class="w-3.5 h-3.5 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
            </div>
        </a>
    </div>

    <!-- Quick Export Strip -->
    <QuickExportBar Parameters="@LogoParameters.CreateApproved()" />

    <!-- Brand Philosophy Matrix (Reflection, Intelligence, Harmony, Timeless, Lightweight) -->
    <div class="space-y-4 pt-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">Brand Philosophy (品牌哲学)</h3>
                <p class="text-xs text-neutral-500">月 · 兰 · C — 灵感源自月亮的盈缺、兰花的优雅以及字母 C 的本源</p>
            </div>
            <span class="text-xs font-serif italic text-neutral-400">Reflection. Intelligence. Harmony.</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-4">
            @foreach (var item in GuidelineProvider.GetPhilosophyItems())
            {
                <div class="p-5 rounded-2xl border border-neutral-200/70 dark:border-neutral-800 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-sm space-y-2">
                    <div class="flex items-center space-x-2">
                        <span class="text-base font-bold text-neutral-900 dark:text-white">@item.Title</span>
                    </div>
                    <div class="text-xs font-medium text-neutral-400">@item.ChineseTitle</div>
                    <div class="text-xs font-semibold text-neutral-700 dark:text-neutral-300 italic font-serif pt-1">
                        "@item.Subtitle"
                    </div>
                    <p class="text-[11px] text-neutral-500 leading-relaxed pt-1">
                        @item.ChineseDescription
                    </p>
                </div>
            }
        </div>
    </div>
</div>
