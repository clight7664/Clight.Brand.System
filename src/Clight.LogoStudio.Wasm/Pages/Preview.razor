@page "/preview"
@inject ISvgLogoRenderer SvgRenderer
@inject IJSRuntime JSRuntime
@inject ILocalizationService I18n
@implements IDisposable

<div class="space-y-8 animate-fade-in">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">@I18n["Preview.Title"]</h1>
            <p class="text-xs text-neutral-500 mt-1">@I18n["Preview.Desc"]</p>
        </div>

        <!-- Background Theme Pills -->
        <div class="flex items-center p-1 rounded-xl bg-neutral-200/60 dark:bg-neutral-800 text-xs font-medium space-x-1">
            <button @onclick="() => selectedTheme = LogoTheme.Light" class="px-3 py-1.5 rounded-lg transition-colors @(selectedTheme == LogoTheme.Light ? "bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white shadow-sm font-semibold" : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900")">
                @I18n["Preview.ThemeLight"]
            </button>
            <button @onclick="() => selectedTheme = LogoTheme.Dark" class="px-3 py-1.5 rounded-lg transition-colors @(selectedTheme == LogoTheme.Dark ? "bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white shadow-sm font-semibold" : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900")">
                @I18n["Preview.ThemeDark"]
            </button>
            <button @onclick="() => selectedTheme = LogoTheme.Transparent" class="px-3 py-1.5 rounded-lg transition-colors @(selectedTheme == LogoTheme.Transparent ? "bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white shadow-sm font-semibold" : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900")">
                @I18n["Preview.ThemeTransparent"]
            </button>
            <button @onclick="() => selectedTheme = LogoTheme.Paper" class="px-3 py-1.5 rounded-lg transition-colors @(selectedTheme == LogoTheme.Paper ? "bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white shadow-sm font-semibold" : "text-neutral-600 dark:text-neutral-400 hover:text-neutral-900")">
                @I18n["Preview.ThemePaper"]
            </button>
        </div>
    </div>

    <!-- Main Canvas & Side Panels -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Main Interactive Canvas (2 cols) -->
        <div class="lg:col-span-2 space-y-3">
            <div class="relative w-full aspect-square max-h-[560px] flex items-center justify-center">
                <SvgLogoViewer Parameters="@currentParameters" Theme="@selectedTheme" ViewMode="@currentViewMode" ZoomLevel="@zoomScale" />

                <!-- Canvas Floating Toolbar -->
                <div class="absolute top-4 right-4 flex items-center space-x-1.5 p-1 rounded-xl bg-white/80 dark:bg-neutral-900/80 backdrop-blur-md border border-neutral-200/60 dark:border-neutral-800 shadow-sm text-xs">
                    <button @onclick="ZoomOut" class="p-1.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-300" title="Zoom Out">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4" /></svg>
                    </button>
                    <span class="px-1.5 font-mono text-[11px] text-neutral-500">@((int)(zoomScale * 100))%</span>
                    <button @onclick="ZoomIn" class="p-1.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-300" title="Zoom In">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" /></svg>
                    </button>
                    <button @onclick="ResetZoom" class="p-1.5 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-300" title="Reset Zoom">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    </button>
                </div>
            </div>

            <!-- View Mode Bar -->
            <div class="flex flex-wrap items-center justify-between gap-2 p-3 rounded-xl bg-white/60 dark:bg-neutral-900/60 border border-neutral-200/60 dark:border-neutral-800 text-xs">
                <div class="flex items-center space-x-2">
                    <span class="text-neutral-400 font-medium">@I18n["Preview.LayerLabel"]</span>
                    <button @onclick='() => currentViewMode = "standard"' class="px-2.5 py-1 rounded-md transition-colors @(currentViewMode == "standard" ? "bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 font-medium" : "hover:bg-neutral-200/50 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-400")">
                        @I18n["Preview.LayerStandard"]
                    </button>
                    <button @onclick='() => currentViewMode = "construction"' class="px-2.5 py-1 rounded-md transition-colors @(currentViewMode == "construction" ? "bg-sky-600 text-white font-medium" : "hover:bg-neutral-200/50 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-400")">
                        @I18n["Preview.LayerConstruction"]
                    </button>
                    <button @onclick='() => currentViewMode = "grid"' class="px-2.5 py-1 rounded-md transition-colors @(currentViewMode == "grid" ? "bg-neutral-800 text-white font-medium" : "hover:bg-neutral-200/50 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-400")">
                        @I18n["Preview.LayerGrid"]
                    </button>
                    <button @onclick='() => currentViewMode = "safe-area"' class="px-2.5 py-1 rounded-md transition-colors @(currentViewMode == "safe-area" ? "bg-emerald-600 text-white font-medium" : "hover:bg-neutral-200/50 dark:hover:bg-neutral-800 text-neutral-600 dark:text-neutral-400")">
                        @I18n["Preview.LayerSafeArea"]
                    </button>
                </div>
                <div class="text-[11px] font-mono text-neutral-400">
                    φ = 1.618034 • 512×512
                </div>
            </div>
        </div>

        <!-- Controls & Quick Preview Cards (1 col) -->
        <div class="space-y-4">
            <!-- Controls Card -->
            <div class="p-5 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4 shadow-sm">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-400">@I18n["Preview.ControlsTitle"]</h3>
                
                <div class="space-y-3 text-xs">
                    <div>
                        <label class="block text-neutral-500 mb-1 font-medium">@I18n["Preview.ExportFormat"]</label>
                        <select @bind="selectedExportFormat" class="w-full p-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white">
                            <option value="PNG">PNG (Raster)</option>
                            <option value="SVG">SVG (Vector)</option>
                            <option value="ICO">ICO (Windows Favicon)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-neutral-500 mb-1 font-medium">@I18n["Preview.LogoResolution"]</label>
                        <select @bind="selectedSize" class="w-full p-2 rounded-lg bg-neutral-100 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 text-neutral-900 dark:text-white">
                            <option value="16">16×16 px</option>
                            <option value="32">32×32 px</option>
                            <option value="64">64×64 px</option>
                            <option value="128">128×128 px</option>
                            <option value="256">256×256 px</option>
                            <option value="512">512×512 px</option>
                            <option value="1024">1024×1024 px</option>
                        </select>
                    </div>

                    <div class="pt-2 space-y-2">
                        <button @onclick="ExportCurrent" class="w-full py-2.5 text-xs font-semibold text-white bg-neutral-900 dark:bg-white dark:text-neutral-900 rounded-lg hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors shadow-sm">
                            @I18n["Preview.ExportCurrent"]
                        </button>
                    </div>

                    <div class="p-3 rounded-lg bg-neutral-50 dark:bg-neutral-800/50 border border-neutral-200/50 dark:border-neutral-700/50 text-[11px] text-neutral-500 leading-relaxed">
                        @I18n["Preview.ExportNotice"]
                    </div>
                </div>
            </div>

            <!-- Mini Favicon Preview Card -->
            <div class="p-4 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="font-semibold text-neutral-900 dark:text-white">@I18n["Preview.FaviconPreviewTitle"]</span>
                    <span class="text-neutral-400 font-mono text-[10px]">32×32 • 16×16</span>
                </div>
                <div class="p-3 rounded-lg bg-neutral-100 dark:bg-neutral-950 flex items-center justify-center space-x-6 border border-neutral-200/50 dark:border-neutral-800">
                    <div class="flex items-center space-x-2">
                        <div class="w-8 h-8 bg-white p-1 rounded shadow-sm flex items-center justify-center border border-neutral-200">
                            @((MarkupString)SvgRenderer.RenderSvg(currentParameters, new SvgRenderOptions { Responsive = true, FillColor = "#111111" }))
                        </div>
                        <div class="w-4 h-4 bg-white p-0.5 rounded shadow-sm flex items-center justify-center border border-neutral-200">
                            @((MarkupString)SvgRenderer.RenderSvg(currentParameters, new SvgRenderOptions { Responsive = true, FillColor = "#111111" }))
                        </div>
                    </div>
                    <div class="flex items-center space-x-2">
                        <div class="w-8 h-8 bg-[#111111] p-1 rounded shadow-sm flex items-center justify-center border border-neutral-800">
                            @((MarkupString)SvgRenderer.RenderSvg(currentParameters, new SvgRenderOptions { Responsive = true, FillColor = "#FFFFFF" }))
                        </div>
                        <div class="w-4 h-4 bg-[#111111] p-0.5 rounded shadow-sm flex items-center justify-center border border-neutral-800">
                            @((MarkupString)SvgRenderer.RenderSvg(currentParameters, new SvgRenderOptions { Responsive = true, FillColor = "#FFFFFF" }))
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mini App Icon Preview Card -->
            <div class="p-4 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-2">
                <div class="flex items-center justify-between text-xs">
                    <span class="font-semibold text-neutral-900 dark:text-white">@I18n["Preview.AppIconPreviewTitle"]</span>
                    <span class="text-neutral-400 font-mono text-[10px]">512×512 iOS</span>
                </div>
                <div class="p-3 rounded-lg bg-neutral-100 dark:bg-neutral-950 flex items-center justify-center space-x-4 border border-neutral-200/50 dark:border-neutral-800">
                    <div class="w-16 h-16 rounded-[22%] bg-white p-3 shadow-md flex items-center justify-center">
                        @((MarkupString)SvgRenderer.RenderSvg(currentParameters, new SvgRenderOptions { Responsive = true, FillColor = "#111111" }))
                    </div>
                    <div class="w-16 h-16 rounded-[22%] bg-[#111111] p-3 shadow-md flex items-center justify-center">
                        @((MarkupString)SvgRenderer.RenderSvg(currentParameters, new SvgRenderOptions { Responsive = true, FillColor = "#FFFFFF" }))
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Size Matrix Grid Component -->
    <div class="pt-6 border-t border-neutral-200/70 dark:border-neutral-800">
        <SizeMatrixGrid Parameters="@currentParameters" />
    </div>
</div>

@code {
    private LogoParameters currentParameters = LogoParameters.CreateApproved();
    private LogoTheme selectedTheme = LogoTheme.Light;
    private string currentViewMode = "standard";
    private double zoomScale = 1.0;
    private string selectedExportFormat = "PNG";
    private int selectedSize = 512;

    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += StateHasChanged;
    }

    private void ZoomIn() => zoomScale = Math.Min(3.0, zoomScale + 0.25);
    private void ZoomOut() => zoomScale = Math.Max(0.5, zoomScale - 0.25);
    private void ResetZoom() => zoomScale = 1.0;

    private async Task ExportCurrent()
    {
        string svg = SvgRenderer.RenderSvg(currentParameters);
        if (selectedExportFormat == "SVG")
        {
            await JSRuntime.InvokeVoidAsync("logoStudio.downloadTextFile", "clight-logo.svg", svg, "image/svg+xml");
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("logoStudio.renderSvgToPngAndDownload", svg, selectedSize, selectedSize, $"clight-logo-{selectedSize}.png", null);
        }
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= StateHasChanged;
    }
}
