@page "/typography"
@inject IGuidelineProvider GuidelineProvider
@inject ISvgLogoRenderer SvgRenderer

<div class="space-y-10 animate-fade-in">
    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">Brand Color &amp; Typography (色彩与字型)</h1>
        <p class="text-xs text-neutral-500 mt-1">Official color palette specifications, font hierarchy pairings, and logo integrity governance.</p>
    </div>

    <!-- 1. Color Palette Tokens -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Brand Color Palette (品牌调色板)</h2>
            <span class="text-xs font-mono text-neutral-400">5 Primary Tokens</span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
            <ColorSwatchCard Color="@BrandColor.InkBlack" />
            <ColorSwatchCard Color="@BrandColor.PaperWhite" />
            <ColorSwatchCard Color="@BrandColor.MistGray" />
            <ColorSwatchCard Color="@BrandColor.DeepGray" />
            <ColorSwatchCard Color="@BrandColor.PureWhite" />
        </div>
    </div>

    <!-- 2. Typography Specimen -->
    <div class="space-y-4 pt-4 border-t border-neutral-200/70 dark:border-neutral-800">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Typography System (标准字型系统)</h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Primary UI Font: Inter / Plus Jakarta Sans -->
            <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-base font-semibold text-neutral-900 dark:text-white font-sans">Inter / Plus Jakarta Sans</h3>
                        <p class="text-xs text-neutral-400">Primary UI, headings, body copy, and digital interfaces</p>
                    </div>
                    <span class="text-xs font-mono font-bold px-2 py-1 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">Sans-Serif</span>
                </div>
                <div class="text-4xl font-bold font-sans tracking-tight text-neutral-900 dark:text-white py-2">
                    Aa Bb Gg 0123
                </div>
                <div class="text-xs font-mono text-neutral-500 break-all">
                    ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />
                    abcdefghijklmnopqrstuvwxyz 0123456789
                </div>
                <div class="pt-2 border-t border-neutral-100 dark:border-neutral-800 text-xs text-neutral-600 dark:text-neutral-400">
                    Characterized by crisp geometry, open counters, and high legibility at micro scales.
                </div>
            </div>

            <!-- Display Accent Font: Cormorant Garamond -->
            <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-base font-semibold text-neutral-900 dark:text-white font-serif">Cormorant Garamond</h3>
                        <p class="text-xs text-neutral-400">Editorial headlines, philosophy storytelling, and brand narrative</p>
                    </div>
                    <span class="text-xs font-mono font-bold px-2 py-1 rounded bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300">Serif</span>
                </div>
                <div class="text-4xl font-normal font-serif italic text-neutral-900 dark:text-white py-2">
                    Reflection &amp; Grace
                </div>
                <div class="text-xs font-mono text-neutral-500 break-all">
                    ABCDEFGHIJKLMNOPQRSTUVWXYZ<br />
                    abcdefghijklmnopqrstuvwxyz 0123456789
                </div>
                <div class="pt-2 border-t border-neutral-100 dark:border-neutral-800 text-xs text-neutral-600 dark:text-neutral-400">
                    High contrast strokes inspired by classical letterforms, reflecting stillness and literary elegance.
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Logo Usage Do's & Don'ts -->
    <div class="space-y-4 pt-4 border-t border-neutral-200/70 dark:border-neutral-800">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-neutral-400">Logo Usage Governance (正确与错误使用规范)</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
            @foreach (var rule in GuidelineProvider.GetUsageRules())
            {
                <DosAndDontsCard Rule="@rule" />
            }
        </div>
    </div>
</div>
