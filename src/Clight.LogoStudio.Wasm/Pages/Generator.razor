@page "/generator"
@inject ILogoCalculator Calculator
@inject ISvgLogoRenderer SvgRenderer
@inject IJSRuntime JSRuntime

<div class="space-y-8 animate-fade-in">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">Logo Generator (生成器)</h1>
            <p class="text-xs text-neutral-500 mt-1">Customize your logo parameters: curve curvature, outer radius, stroke width, and golden ratio harmony.</p>
        </div>

        <div class="flex items-center space-x-2">
            <button @onclick="ResetToApproved" class="px-3 py-1.5 text-xs font-medium rounded-lg border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300 transition-colors">
                Reset Approved
            </button>
            <button @onclick="CopySvgPath" class="px-3 py-1.5 text-xs font-semibold rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 hover:bg-neutral-800 transition-colors flex items-center space-x-1.5">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" /></svg>
                <span>@(isCopied ? "✓ Path Copied" : "Copy SVG Path")</span>
            </button>
        </div>
    </div>

    <!-- Parameter Editor Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Parameters Column (5 cols) -->
        <div class="lg:col-span-5 space-y-5">
            <!-- Curve Parameters Section -->
            <div class="p-5 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4">
                <div class="flex items-center justify-between border-b border-neutral-100 dark:border-neutral-800 pb-2">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Curve Geometry (曲线几何)</h3>
                    <label class="flex items-center space-x-1.5 text-xs cursor-pointer">
                        <input type="checkbox" @bind="paramsModel.UseGoldenRatio" @bind:after="OnParamChanged" class="rounded text-amber-500 focus:ring-amber-400" />
                        <span class="text-neutral-700 dark:text-neutral-300 font-medium">φ Lock (1.618)</span>
                    </label>
                </div>

                <!-- Outer Radius -->
                <div class="space-y-1">
                    <div class="flex justify-between text-xs">
                        <span class="text-neutral-600 dark:text-neutral-400">Outer Radius (外半径 R_out)</span>
                        <span class="font-mono font-medium text-neutral-900 dark:text-white">@paramsModel.OuterRadius.ToString("F0") px</span>
                    </div>
                    <input type="range" min="100" max="250" step="1" @bind="paramsModel.OuterRadius" @bind:after="OnParamChanged" class="w-full h-1.5 bg-neutral-200 dark:bg-neutral-700 rounded-lg appearance-none cursor-pointer accent-neutral-900 dark:accent-white" />
                </div>

                <!-- Stroke Width / Crest Thickness -->
                <div class="space-y-1">
                    <div class="flex justify-between text-xs">
                        <span class="text-neutral-600 dark:text-neutral-400">Stroke Width (峰值厚度 W)</span>
                        <span class="font-mono font-medium text-neutral-900 dark:text-white">@paramsModel.StrokeWidth.ToString("F0") px</span>
                    </div>
                    <input type="range" min="6" max="70" step="1" @bind="paramsModel.StrokeWidth" @bind:after="OnParamChanged" class="w-full h-1.5 bg-neutral-200 dark:bg-neutral-700 rounded-lg appearance-none cursor-pointer accent-neutral-900 dark:accent-white" />
                </div>

                <!-- Tip Opening Angle -->
                <div class="space-y-1">
                    <div class="flex justify-between text-xs">
                        <span class="text-neutral-600 dark:text-neutral-400">Tip Angle (开口尖角 α)</span>
                        <span class="font-mono font-medium text-neutral-900 dark:text-white">@paramsModel.TipAngleDegrees.ToString("F0")°</span>
                    </div>
                    <input type="range" min="20" max="75" step="1" @bind="paramsModel.TipAngleDegrees" @bind:after="OnParamChanged" class="w-full h-1.5 bg-neutral-200 dark:bg-neutral-700 rounded-lg appearance-none cursor-pointer accent-neutral-900 dark:accent-white" />
                </div>
            </div>

            <!-- Weight Presets Section -->
            <div class="p-5 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-3">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Weight Presets (粗细预设)</h3>
                <div class="grid grid-cols-3 gap-2">
                    <button @onclick="() => SetPreset(WeightPreset.Thin)" class="py-2 px-3 rounded-xl border transition-all text-xs font-medium @(paramsModel.Weight == WeightPreset.Thin ? "border-neutral-900 dark:border-white bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 shadow-sm" : "border-neutral-200 dark:border-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300")">
                        Thin (16px)
                    </button>
                    <button @onclick="() => SetPreset(WeightPreset.Regular)" class="py-2 px-3 rounded-xl border transition-all text-xs font-medium @(paramsModel.Weight == WeightPreset.Regular ? "border-neutral-900 dark:border-white bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 shadow-sm" : "border-neutral-200 dark:border-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300")">
                        Regular (26px)
                    </button>
                    <button @onclick="() => SetPreset(WeightPreset.Bold)" class="py-2 px-3 rounded-xl border transition-all text-xs font-medium @(paramsModel.Weight == WeightPreset.Bold ? "border-neutral-900 dark:border-white bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 shadow-sm" : "border-neutral-200 dark:border-neutral-800 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-700 dark:text-neutral-300")">
                        Bold (42px)
                    </button>
                </div>
            </div>

            <!-- Position & Symmetry Section -->
            <div class="p-5 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Position &amp; Symmetry (对称与偏移)</h3>

                <div class="grid grid-cols-2 gap-3 text-xs">
                    <div>
                        <div class="flex justify-between text-[11px] text-neutral-500 mb-1">
                            <span>X Offset</span>
                            <span class="font-mono">@paramsModel.CenterOffsetX px</span>
                        </div>
                        <input type="range" min="-40" max="40" step="1" @bind="paramsModel.CenterOffsetX" @bind:after="OnParamChanged" class="w-full h-1.5 bg-neutral-200 dark:bg-neutral-700 rounded-lg appearance-none cursor-pointer accent-neutral-900 dark:accent-white" />
                    </div>
                    <div>
                        <div class="flex justify-between text-[11px] text-neutral-500 mb-1">
                            <span>Y Offset</span>
                            <span class="font-mono">@paramsModel.CenterOffsetY px</span>
                        </div>
                        <input type="range" min="-40" max="40" step="1" @bind="paramsModel.CenterOffsetY" @bind:after="OnParamChanged" class="w-full h-1.5 bg-neutral-200 dark:bg-neutral-700 rounded-lg appearance-none cursor-pointer accent-neutral-900 dark:accent-white" />
                    </div>
                </div>

                <div class="flex items-center justify-between pt-2 border-t border-neutral-100 dark:border-neutral-800">
                    <label class="flex items-center space-x-2 text-xs cursor-pointer">
                        <input type="checkbox" @bind="paramsModel.MirrorVertical" @bind:after="OnParamChanged" class="rounded text-neutral-900 dark:text-white" />
                        <span class="text-neutral-700 dark:text-neutral-300">Mirror Vertical (垂直翻转)</span>
                    </label>
                    <label class="flex items-center space-x-2 text-xs cursor-pointer">
                        <input type="checkbox" @bind="paramsModel.MirrorHorizontal" @bind:after="OnParamChanged" class="rounded text-neutral-900 dark:text-white" />
                        <span class="text-neutral-700 dark:text-neutral-300">Mirror Horizontal (水平翻转)</span>
                    </label>
                </div>
            </div>
        </div>

        <!-- Live Canvas & SVG Inspector Column (7 cols) -->
        <div class="lg:col-span-7 space-y-4">
            <!-- Canvas -->
            <div class="relative w-full aspect-square max-h-[500px] flex items-center justify-center">
                <SvgLogoViewer Parameters="@paramsModel" Theme="LogoTheme.Light" />
            </div>

            <!-- Mathematical Path Inspector -->
            <div class="p-4 rounded-xl border border-neutral-200/80 dark:border-neutral-800 bg-neutral-900 text-neutral-100 font-mono text-xs space-y-2">
                <div class="flex items-center justify-between text-[11px] text-neutral-400">
                    <span>Generated SVG Path Output (d attribute)</span>
                    <span class="text-emerald-400">R_in: @computedGeometry.InnerRadius.ToString("F2")px</span>
                </div>
                <div class="p-2.5 rounded bg-neutral-950 text-neutral-300 break-all select-all leading-relaxed text-[11px]">
                    @computedGeometry.SvgPathData
                </div>
                <div class="flex justify-between items-center text-[10px] text-neutral-500 pt-1">
                    <span>LargeArcOut: @computedGeometry.LargeArcOuter | LargeArcIn: @computedGeometry.LargeArcInner</span>
                    <span>Radius Ratio: @computedGeometry.RadiusRatio.ToString("F3")</span>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LogoParameters paramsModel = LogoParameters.CreateApproved();
    private LogoGeometry computedGeometry = new();
    private bool isCopied = false;

    protected override void OnInitialized()
    {
        OnParamChanged();
    }

    private void OnParamChanged()
    {
        computedGeometry = Calculator.CalculateGeometry(paramsModel);
    }

    private void SetPreset(WeightPreset preset)
    {
        paramsModel = paramsModel.WithWeight(preset);
        OnParamChanged();
    }

    private void ResetToApproved()
    {
        paramsModel = LogoParameters.CreateApproved();
        OnParamChanged();
    }

    private async Task CopySvgPath()
    {
        await JSRuntime.InvokeVoidAsync("logoStudio.copyToClipboard", computedGeometry.SvgPathData);
        isCopied = true;
        StateHasChanged();
        await Task.Delay(1500);
        isCopied = false;
        StateHasChanged();
    }
}
