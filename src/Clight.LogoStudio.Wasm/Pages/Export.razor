@page "/export"
@inject IAssetGenerator AssetGenerator
@inject ISvgLogoRenderer SvgRenderer
@inject IJSRuntime JSRuntime

<div class="space-y-8 animate-fade-in">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">Brand Asset Export (资源导出)</h1>
            <p class="text-xs text-neutral-500 mt-1">Export approved brand assets across vector SVGs, multi-resolution PNGs, and Windows ICO formats.</p>
        </div>

        <div class="flex items-center space-x-2">
            <button @onclick="ExportSelected" disabled="@(selectedSizes.Count == 0 || isExporting)" class="px-4 py-2 text-xs font-semibold rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 hover:bg-neutral-800 disabled:opacity-50 transition-all flex items-center space-x-1.5 shadow-sm">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                <span>Export Selected (@selectedSizes.Count)</span>
            </button>
            <button @onclick="ExportAll" disabled="@isExporting" class="px-4 py-2 text-xs font-semibold rounded-lg border border-neutral-300 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 text-neutral-800 dark:text-neutral-200 transition-colors">
                Export All (ZIP)
            </button>
        </div>
    </div>

    <!-- Format Tabs & Selection Matrix Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Selection Sidebar (4 cols) -->
        <div class="lg:col-span-4 space-y-4">
            <div class="p-5 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4 shadow-sm">
                <div class="flex items-center justify-between border-b border-neutral-100 dark:border-neutral-800 pb-2">
                    <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-400">PNG Sizes (像素规格)</h3>
                    <button @onclick="ToggleAllSizes" class="text-xs font-medium text-neutral-600 dark:text-neutral-400 hover:text-neutral-900">
                        @(selectedSizes.Count == allSizes.Length ? "Deselect All" : "Select All")
                    </button>
                </div>

                <div class="space-y-2 text-xs">
                    @foreach (var size in allSizes)
                    {
                        <label class="flex items-center justify-between p-2 rounded-lg hover:bg-neutral-100 dark:hover:bg-neutral-800/60 cursor-pointer transition-colors">
                            <div class="flex items-center space-x-2.5">
                                <input type="checkbox" checked="@selectedSizes.Contains(size)" @onchange="(e) => ToggleSize(size, (bool?)e.Value ?? false)" class="rounded text-neutral-900 dark:text-white" />
                                <span class="font-mono font-medium text-neutral-800 dark:text-neutral-200">@(size) × @(size)</span>
                            </div>
                            <span class="text-[10px] text-neutral-400 font-mono">@GetSizeDescription(size)</span>
                        </label>
                    }
                </div>
            </div>

            <!-- Vector & ICO Quick Actions -->
            <div class="p-5 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-3">
                <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-400">Direct Vector &amp; Icon Downloads</h3>
                <div class="space-y-2">
                    <button @onclick="DownloadSvgCanonical" class="w-full py-2 px-3 text-xs font-medium rounded-lg border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 flex items-center justify-between transition-colors">
                        <span>clight-logo.svg (Black Vector)</span>
                        <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                    </button>
                    <button @onclick="DownloadSvgWhiteTransparent" class="w-full py-2 px-3 text-xs font-medium rounded-lg bg-neutral-900 text-white dark:bg-white dark:text-neutral-900 hover:bg-neutral-800 dark:hover:bg-neutral-100 flex items-center justify-between transition-colors shadow-sm">
                        <span>clight-logo-white.svg (White Transparent)</span>
                        <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                    </button>
                    <button @onclick="DownloadSvgWhite" class="w-full py-2 px-3 text-xs font-medium rounded-lg border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 flex items-center justify-between transition-colors">
                        <span>clight-logo-dark.svg (White on Black)</span>
                        <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                    </button>
                    <button @onclick="DownloadIco" class="w-full py-2 px-3 text-xs font-medium rounded-lg border border-neutral-200 dark:border-neutral-700 hover:bg-neutral-100 dark:hover:bg-neutral-800 flex items-center justify-between transition-colors">
                        <span>favicon.ico (Multi-res 16-256)</span>
                        <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Visual Grid Preview (8 cols) -->
        <div class="lg:col-span-8 space-y-4">
            <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-sm space-y-6 shadow-sm">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-sm font-semibold text-neutral-900 dark:text-white">Export Canvas Gallery (导出资源预览)</h3>
                        <p class="text-xs text-neutral-500">Visual preview of approved logo geometry scaled across target resolutions.</p>
                    </div>
                    <span class="text-xs font-mono text-neutral-400">@selectedSizes.Count Sizes Selected</span>
                </div>

                <!-- Preview Grid Cards -->
                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
                    @foreach (var size in allSizes)
                    {
                        bool isSelected = selectedSizes.Contains(size);
                        <div class="flex flex-col items-center justify-between p-4 rounded-xl border transition-all @(isSelected ? "border-neutral-900 dark:border-white bg-white dark:bg-neutral-900 shadow-md" : "border-neutral-200/60 dark:border-neutral-800/60 opacity-40 bg-neutral-50 dark:bg-neutral-950")">
                            <span class="text-[11px] font-mono font-medium text-neutral-500">@(size)×@(size)</span>
                            <div class="my-4 flex items-center justify-center text-neutral-900 dark:text-white" style="width: @(GetBoxSize(size))px; height: @(GetBoxSize(size))px;">
                                <div style="width: @(GetInnerIconSize(size))px; height: @(GetInnerIconSize(size))px;">
                                    @((MarkupString)SvgRenderer.RenderSvg(LogoParameters.CreateApproved(), new SvgRenderOptions { Responsive = true, FillColor = "currentColor" }))
                                </div>
                            </div>
                            <button @onclick="() => DownloadSinglePng(size)" class="w-full py-1 text-[10px] font-mono rounded bg-neutral-100 dark:bg-neutral-800 hover:bg-neutral-200 dark:hover:bg-neutral-700 text-neutral-700 dark:text-neutral-300 transition-colors">
                                Download
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly int[] allSizes = [16, 32, 48, 64, 128, 180, 192, 256, 512, 1024];
    private HashSet<int> selectedSizes = [16, 32, 48, 64, 128, 180, 192, 256, 512, 1024];
    private bool isExporting = false;

    private void ToggleSize(int size, bool check)
    {
        if (check) selectedSizes.Add(size);
        else selectedSizes.Remove(size);
    }

    private void ToggleAllSizes()
    {
        if (selectedSizes.Count == allSizes.Length) selectedSizes.Clear();
        else selectedSizes = [.. allSizes];
    }

    private string GetSizeDescription(int size) => size switch
    {
        16 => "Browser Tab Favicon",
        32 => "Retina Favicon",
        48 => "Windows Taskbar",
        64 => "Dock Icon Small",
        128 => "App Store Small",
        180 => "Apple Touch Icon",
        192 => "Android Chrome",
        256 => "macOS Dock Medium",
        512 => "Android PWA Splash",
        1024 => "Master Retina Art",
        _ => "Standard Export"
    };

    private int GetBoxSize(int size) => size switch
    {
        <= 32 => 36,
        <= 64 => 48,
        <= 128 => 60,
        _ => 72
    };

    private int GetInnerIconSize(int size) => size switch
    {
        <= 16 => 16,
        <= 32 => 28,
        <= 48 => 40,
        <= 64 => 48,
        <= 128 => 56,
        _ => 64
    };

    private async Task DownloadSinglePng(int size)
    {
        string svg = SvgRenderer.RenderSvg(LogoParameters.CreateApproved());
        await JSRuntime.InvokeVoidAsync("logoStudio.renderSvgToPngAndDownload", svg, size, size, $"clight-logo-{size}.png", null);
    }

    private async Task ExportSelected()
    {
        isExporting = true;
        StateHasChanged();
        try
        {
            string svg = SvgRenderer.RenderSvg(LogoParameters.CreateApproved());
            foreach (var size in selectedSizes)
            {
                await JSRuntime.InvokeVoidAsync("logoStudio.renderSvgToPngAndDownload", svg, size, size, $"clight-logo-{size}.png", null);
            }
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task ExportAll()
    {
        isExporting = true;
        StateHasChanged();
        try
        {
            string svg = SvgRenderer.RenderSvg(LogoParameters.CreateApproved());
            await JSRuntime.InvokeVoidAsync("logoStudio.exportAllAssetsAsZip", svg, "Clight.Brand.Assets.zip");
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }

    private async Task DownloadSvgCanonical()
    {
        string svg = SvgRenderer.RenderSvg(LogoParameters.CreateApproved(), new SvgRenderOptions { IncludeXmlDeclaration = true });
        await JSRuntime.InvokeVoidAsync("logoStudio.downloadTextFile", "clight-logo.svg", svg, "image/svg+xml");
    }

    private async Task DownloadSvgWhiteTransparent()
    {
        string svg = SvgRenderer.RenderSvg(LogoParameters.CreateApproved(), new SvgRenderOptions { FillColor = "#FFFFFF", BackgroundColor = null, IncludeXmlDeclaration = true });
        await JSRuntime.InvokeVoidAsync("logoStudio.downloadTextFile", "clight-logo-white-transparent.svg", svg, "image/svg+xml");
    }

    private async Task DownloadSvgWhite()
    {
        string svg = SvgRenderer.RenderSvg(LogoParameters.CreateApproved(), new SvgRenderOptions { FillColor = "#FFFFFF", BackgroundColor = "#111111", IncludeXmlDeclaration = true });
        await JSRuntime.InvokeVoidAsync("logoStudio.downloadTextFile", "clight-logo-white.svg", svg, "image/svg+xml");
    }

    private async Task DownloadIco()
    {
        string svg = SvgRenderer.RenderSvg(LogoParameters.CreateApproved());
        await JSRuntime.InvokeVoidAsync("logoStudio.renderSvgToPngAndDownload", svg, 32, 32, "favicon.ico", null);
    }
}
