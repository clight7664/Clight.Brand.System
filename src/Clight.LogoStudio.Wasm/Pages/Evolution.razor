@page "/evolution"
@inject ISvgLogoRenderer SvgRenderer

<div class="space-y-10 animate-fade-in">
    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white">Design Evolution (演化过程)</h1>
        <p class="text-xs text-neutral-500 mt-1">The iterative transformation of the Clight logo from initial geometric exploration to refined minimalist essence.</p>
    </div>

    <!-- 4 Stage Evolution Timeline -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Stage 1: Original Blueprint -->
        <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4 flex flex-col justify-between">
            <div class="space-y-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-neutral-400">Stage 01</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Original (原始构造)</h3>
                <p class="text-xs text-neutral-500">Complex geometric intersection of overlapping golden ratio circles and radial coordinates.</p>
            </div>
            <div class="w-full aspect-square rounded-xl bg-[#FAF9F6] border border-neutral-200 p-4 flex items-center justify-center">
                @((MarkupString)SvgRenderer.RenderConstructionSvg(LogoParameters.CreateApproved(), new ConstructionRenderOptions { ShowDimensionLabels = false }))
            </div>
        </div>

        <!-- Stage 2: Concept Curve -->
        <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4 flex flex-col justify-between">
            <div class="space-y-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-neutral-400">Stage 02</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Concept (兰花曲线)</h3>
                <p class="text-xs text-neutral-500">Fluid organic curve inspired by the petal contour of an orchid and natural growth spirals.</p>
            </div>
            <div class="w-full aspect-square rounded-xl bg-[#FAF9F6] dark:bg-[#161616] border border-neutral-200 dark:border-neutral-800 p-4 flex items-center justify-center text-neutral-800 dark:text-neutral-200">
                <svg viewBox="0 0 512 512" class="w-full h-full" fill="currentColor">
                    <path d="M 420 120 C 300 80, 100 150, 80 256 C 60 360, 280 440, 420 392 C 260 410, 140 330, 140 256 C 140 180, 300 110, 420 120 Z" />
                </svg>
            </div>
        </div>

        <!-- Stage 3: Refined Crescent -->
        <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4 flex flex-col justify-between">
            <div class="space-y-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-neutral-400">Stage 03</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Refined (月之月魄)</h3>
                <p class="text-xs text-neutral-500">Mathematical crescent calibration harmonizing tip knife-edges with crest thickness.</p>
            </div>
            <div class="w-full aspect-square rounded-xl bg-[#FAF9F6] dark:bg-[#161616] border border-neutral-200 dark:border-neutral-800 p-4 flex items-center justify-center text-neutral-900 dark:text-white">
                @((MarkupString)SvgRenderer.RenderSvg(LogoParameters.CreateApproved() with { StrokeWidth = 36.0 }, new SvgRenderOptions { Responsive = true, FillColor = "currentColor" }))
            </div>
        </div>

        <!-- Stage 4: Approved Final -->
        <div class="p-6 rounded-2xl border-2 border-neutral-900 dark:border-white bg-white dark:bg-neutral-900 shadow-lg space-y-4 flex flex-col justify-between">
            <div class="space-y-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-500">Stage 04 • Approved</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white">Final (Clight Symbol)</h3>
                <p class="text-xs text-neutral-500">The definitive, pure synthesis of Moon, Orchid, and Letter C with golden ratio curvature.</p>
            </div>
            <div class="w-full aspect-square rounded-xl bg-[#FAF9F6] dark:bg-[#161616] border border-neutral-200 dark:border-neutral-800 p-4 flex items-center justify-center text-neutral-900 dark:text-white">
                @((MarkupString)SvgRenderer.RenderSvg(LogoParameters.CreateApproved(), new SvgRenderOptions { Responsive = true, FillColor = "currentColor" }))
            </div>
        </div>
    </div>

    <!-- Philosophy Narrative Banner -->
    <div class="p-8 rounded-3xl border border-neutral-200/80 dark:border-neutral-800 bg-white/60 dark:bg-neutral-900/60 backdrop-blur-md space-y-4">
        <h3 class="text-lg font-semibold text-neutral-900 dark:text-white">Design Evolution Philosophy (设计演化哲学)</h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-300 font-serif italic text-lg leading-relaxed">
            "From complexity to simplicity, from shape to spirit. The Clight logo evolves through continuous refinement to achieve the perfect balance of Eastern aesthetics and modern innovation."
        </p>
        <div class="text-xs text-neutral-500 leading-relaxed max-w-3xl pt-2">
            从纷繁的几何构造到纯粹的留白意境，Clight Logo 的演化历程展现了设计思维的沉淀。通过反复推敲外径、内径与黄金分割的数学配比，去除一切多余笔触，最终凝聚成这一道兼具东方静谧与现代智能力量的极简弧线。
        </div>
    </div>
</div>
