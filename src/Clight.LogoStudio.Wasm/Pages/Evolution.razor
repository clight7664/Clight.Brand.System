@page "/evolution"
@inject ISvgLogoRenderer SvgRenderer
@inject ILocalizationService I18n
@implements IDisposable

<div class="space-y-10 animate-fade-in">
    <!-- Header -->
    <div>
        <h1 class="text-2xl font-bold tracking-tight text-neutral-900 dark:text-white truncate">@I18n["Evolution.Title"]</h1>
        <p class="text-xs text-neutral-500 mt-1 truncate">@I18n["Evolution.Desc"]</p>
    </div>

    <!-- 4 Stage Evolution Timeline -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Stage 1: Original Blueprint -->
        <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4 flex flex-col justify-between min-h-[360px]">
            <div class="space-y-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-neutral-400">Stage 01</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white truncate" title="@I18n["Evolution.Stage1Title"]">@I18n["Evolution.Stage1Title"]</h3>
                <p class="text-xs text-neutral-500 line-clamp-2" title="@I18n["Evolution.Stage1Desc"]">@I18n["Evolution.Stage1Desc"]</p>
            </div>
            <div class="w-full aspect-square rounded-xl bg-[#FAF9F6] border border-neutral-200 p-4 flex items-center justify-center">
                @((MarkupString)SvgRenderer.RenderConstructionSvg(LogoParameters.CreateApproved(), new ConstructionRenderOptions { ShowDimensionLabels = false }))
            </div>
        </div>

        <!-- Stage 2: Concept Curve -->
        <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4 flex flex-col justify-between min-h-[360px]">
            <div class="space-y-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-neutral-400">Stage 02</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white truncate" title="@I18n["Evolution.Stage2Title"]">@I18n["Evolution.Stage2Title"]</h3>
                <p class="text-xs text-neutral-500 line-clamp-2" title="@I18n["Evolution.Stage2Desc"]">@I18n["Evolution.Stage2Desc"]</p>
            </div>
            <div class="w-full aspect-square rounded-xl bg-[#FAF9F6] dark:bg-[#161616] border border-neutral-200 dark:border-neutral-800 p-4 flex items-center justify-center text-neutral-800 dark:text-neutral-200">
                <svg viewBox="0 0 512 512" class="w-full h-full" fill="currentColor">
                    <path d="M 420 120 C 300 80, 100 150, 80 256 C 60 360, 280 440, 420 392 C 260 410, 140 330, 140 256 C 140 180, 300 110, 420 120 Z" />
                </svg>
            </div>
        </div>

        <!-- Stage 3: Refined Crescent -->
        <div class="p-6 rounded-2xl border border-neutral-200/80 dark:border-neutral-800 bg-white/70 dark:bg-neutral-900/70 backdrop-blur-sm space-y-4 flex flex-col justify-between min-h-[360px]">
            <div class="space-y-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-neutral-400">Stage 03</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white truncate" title="@I18n["Evolution.Stage3Title"]">@I18n["Evolution.Stage3Title"]</h3>
                <p class="text-xs text-neutral-500 line-clamp-2" title="@I18n["Evolution.Stage3Desc"]">@I18n["Evolution.Stage3Desc"]</p>
            </div>
            <div class="w-full aspect-square rounded-xl bg-[#FAF9F6] dark:bg-[#161616] border border-neutral-200 dark:border-neutral-800 p-4 flex items-center justify-center text-neutral-900 dark:text-white">
                @((MarkupString)SvgRenderer.RenderSvg(LogoParameters.CreateApproved() with { StrokeWidth = 36.0 }, new SvgRenderOptions { Responsive = true, FillColor = "currentColor" }))
            </div>
        </div>

        <!-- Stage 4: Approved Final -->
        <div class="p-6 rounded-2xl border-2 border-neutral-900 dark:border-white bg-white dark:bg-neutral-900 shadow-lg space-y-4 flex flex-col justify-between min-h-[360px]">
            <div class="space-y-2">
                <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-500">@I18n["Evolution.Stage4Approved"]</span>
                <h3 class="text-base font-semibold text-neutral-900 dark:text-white truncate" title="@I18n["Evolution.Stage4Title"]">@I18n["Evolution.Stage4Title"]</h3>
                <p class="text-xs text-neutral-500 line-clamp-2" title="@I18n["Evolution.Stage4Desc"]">@I18n["Evolution.Stage4Desc"]</p>
            </div>
            <div class="w-full aspect-square rounded-xl bg-[#FAF9F6] dark:bg-[#161616] border border-neutral-200 dark:border-neutral-800 p-4 flex items-center justify-center text-neutral-900 dark:text-white">
                @((MarkupString)SvgRenderer.RenderSvg(LogoParameters.CreateApproved(), new SvgRenderOptions { Responsive = true, FillColor = "currentColor" }))
            </div>
        </div>
    </div>

    <!-- Philosophy Narrative Banner -->
    <div class="p-8 rounded-3xl border border-neutral-200/80 dark:border-neutral-800 bg-white/60 dark:bg-neutral-900/60 backdrop-blur-md space-y-4">
        <h3 class="text-lg font-semibold text-neutral-900 dark:text-white truncate">@I18n["Evolution.PhilosophyTitle"]</h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-300 font-serif italic text-lg leading-relaxed line-clamp-2" title="@I18n["Evolution.PhilosophyQuote"]">
            @I18n["Evolution.PhilosophyQuote"]
        </p>
        <div class="text-xs text-neutral-500 leading-relaxed max-w-3xl pt-2">
            @I18n["Evolution.PhilosophyText"]
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        I18n.OnLanguageChanged += StateHasChanged;
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= StateHasChanged;
    }
}
