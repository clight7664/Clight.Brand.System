@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime
@inject ILocalizationService I18n
@implements IDisposable

<div class="min-h-screen flex flex-col md:flex-row bg-[#FAF9F6] dark:bg-[#111111] text-neutral-900 dark:text-neutral-100 antialiased font-sans transition-colors duration-200">
    <!-- Sidebar -->
    <aside class="w-full md:w-64 shrink-0 border-b md:border-b-0 md:border-r border-neutral-200/80 dark:border-neutral-800 bg-[#FAF9F6]/90 dark:bg-[#111111]/90 backdrop-blur-md flex flex-col justify-between p-4 md:p-6 z-20">
        <div>
            <!-- Brand Header -->
            <div class="flex items-center justify-between mb-8">
                <a href="" class="flex items-center space-x-3 group">
                    <div class="w-9 h-9 flex items-center justify-center rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 shadow-sm transition-transform duration-200 group-hover:scale-105">
                        <svg viewBox="0 0 512 512" class="w-6 h-6" fill="currentColor">
                            <path d="M 408.825 97.745 A 220.000 220.000 0 1 0 408.825 414.255 A 209.518 209.518 0 1 1 408.825 97.745 Z" />
                        </svg>
                    </div>
                    <div>
                        <span class="text-xl font-semibold tracking-tight text-neutral-900 dark:text-white">Clight</span>
                        <span class="block text-[10px] uppercase font-mono tracking-widest text-neutral-400">Logo Studio</span>
                    </div>
                </a>

                <!-- Mobile controls (Language + Theme) -->
                <div class="flex items-center space-x-1.5 md:hidden">
                    <LanguageSelector />
                    <button @onclick="ToggleTheme" class="p-2 rounded-lg text-neutral-500 hover:bg-neutral-100 dark:hover:bg-neutral-800" aria-label="Toggle Theme">
                        @if (isDark)
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                        }
                        else
                        {
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                        }
                    </button>
                </div>
            </div>

            <!-- Navigation Links -->
            <NavMenu />
        </div>

        <!-- Sidebar Footer -->
        <div class="mt-8 pt-4 border-t border-neutral-200/60 dark:border-neutral-800/80">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span class="text-xs font-medium text-neutral-500 dark:text-neutral-400">@I18n["Common.BrandSystemVersion"]</span>
                </div>
                <!-- Desktop controls (Language + Theme) -->
                <div class="hidden md:flex items-center space-x-1.5">
                    <LanguageSelector />
                    <button @onclick="ToggleTheme" class="p-1.5 rounded-lg text-neutral-500 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-200/50 dark:hover:bg-neutral-800 transition-colors" title="@I18n["Common.ThemeToggle"]">
                        @if (isDark)
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                        }
                        else
                        {
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                        }
                    </button>
                </div>
            </div>
            <div class="mt-2 text-[11px] text-neutral-400 font-serif italic truncate" title="@I18n["Common.Motto"]">
                @I18n["Common.Motto"]
            </div>
        </div>
    </aside>

    <!-- Main Content Area -->
    <main class="flex-1 flex flex-col min-w-0 overflow-y-auto max-h-screen">
        <div class="flex-1 p-4 md:p-8 lg:p-10 max-w-7xl w-full mx-auto">
            @Body
        </div>
    </main>
</div>

@code {
    private bool isDark = false;

    protected override async Task OnInitializedAsync()
    {
        I18n.OnLanguageChanged += StateHasChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await I18n.InitializeAsync();
            var theme = await JSRuntime.InvokeAsync<string>("logoStudio.getTheme");
            isDark = theme == "dark";
            await JSRuntime.InvokeVoidAsync("logoStudio.setTheme", isDark ? "dark" : "light");
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        isDark = !isDark;
        await JSRuntime.InvokeVoidAsync("logoStudio.setTheme", isDark ? "dark" : "light");
    }

    public void Dispose()
    {
        I18n.OnLanguageChanged -= StateHasChanged;
    }
}
